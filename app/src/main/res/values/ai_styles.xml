<resources>
    <style name="AiReadyStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/corner_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AiReadyStatLabel">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/corner_text_secondary</item>
        <item name="android:textSize">9sp</item>
    </style>
</resources>
