<resources>
    <style name="HistoryTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/corner_text_primary</item>
    </style>
    <style name="HistorySecondary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/corner_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="HistoryFilter" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/corner_text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipBackgroundColor">@color/history_filter_background</item>
        <item name="chipStrokeColor">@color/history_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="textStartPadding">6dp</item>
        <item name="textEndPadding">6dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
    <style name="HistoryArtworkShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5dp</item>
    </style>
    <style name="HistorySummaryValue" parent="HistoryTitle">
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:autoSizeMaxTextSize">18sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
    <style name="HistorySummaryLabel" parent="HistorySecondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">8sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
