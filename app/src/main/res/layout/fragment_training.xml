<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/corner_background"
    android:fillViewport="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.training.TrainingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="100dp"
        android:clipChildren="false"
        android:clipToPadding="false">


        <!-- ===================================================== -->
        <!-- HERO + SESSION SUMMARY -->
        <!-- ===================================================== -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/trainingHeader"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/training_title"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/training_subtitle"
                    android:textColor="@color/corner_red"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PUNCHING BAG -->
            <!--
                Se declara ANTES que la card.
                Por eso la card se dibuja por encima del saco.
            -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/ivTrainingHero"
                android:layout_width="280dp"
                android:layout_height="320dp"
                android:contentDescription="@string/training_punching_bag"
                android:scaleType="fitCenter"
                android:src="@drawable/bag"
                android:translationX="42dp"
                android:translationY="-12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- ================================================= -->
            <!-- SESSION SUMMARY TITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvSessionSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/training_session_summary"
                android:textColor="@color/corner_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/trainingHeader"
                app:layout_constraintStart_toStartOf="parent" />



            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSessionSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                app:cardBackgroundColor="@color/corner_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/corner_card_border"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/tvSessionSummaryTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <!-- ========================================= -->
                    <!-- ROUND / REST / ROUNDS -->
                    <!-- ========================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="118dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">


                        <!-- ROUND -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/training_round_duration"
                                android:src="@drawable/ic_timer"
                                app:tint="@color/corner_red" />

                            <TextView
                                android:id="@+id/tvRoundDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/corner_text_primary"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="3:00" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/training_round"
                                android:textColor="@color/corner_text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- SEPARATOR -->

                        <View
                            android:layout_width="1dp"
                            android:layout_height="64dp"
                            android:background="@color/corner_outline" />


                        <!-- REST -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/training_rest_duration"
                                android:src="@drawable/ic_rest"
                                app:tint="@color/corner_red" />

                            <TextView
                                android:id="@+id/tvRestDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/corner_text_primary"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="1:00" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/training_rest"
                                android:textColor="@color/corner_text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- SEPARATOR -->

                        <View
                            android:layout_width="1dp"
                            android:layout_height="64dp"
                            android:background="@color/corner_outline" />


                        <!-- ROUNDS -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/training_rounds"
                                android:src="@drawable/ic_boxing_glove"
                                app:tint="@color/corner_red" />

                            <TextView
                                android:id="@+id/tvRounds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/corner_text_primary"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="10" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/training_rounds"
                                android:textColor="@color/corner_text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- ========================================= -->
                    <!-- DIVIDER -->
                    <!-- ========================================= -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:background="@color/corner_outline" />


                    <!-- ========================================= -->
                    <!-- ESTIMATED TOTAL DURATION -->
                    <!-- ========================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:contentDescription="@string/training_estimated_duration"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/corner_text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/training_estimated_duration"
                            android:textColor="@color/corner_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvEstimatedDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="39:00" />

                    </LinearLayout>


                    <!-- ========================================= -->
                    <!-- DIVIDER -->
                    <!-- ========================================= -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:background="@color/corner_outline" />


                    <!-- ========================================= -->
                    <!-- ESTIMATED CALORIES -->
                    <!-- ========================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:contentDescription="@string/training_estimated_calories"
                            android:src="@drawable/ic_fire"
                            app:tint="@color/corner_red" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/training_estimated_calories"
                            android:textColor="@color/corner_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvEstimatedCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="450 kcal" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ===================================================== -->
        <!-- EDIT SESSION -->
        <!-- ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditSession"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:text="@string/training_edit_session"
            android:textColor="@color/corner_text_primary"
            android:textStyle="bold"
            app:backgroundTint="@color/corner_surface"
            app:cornerRadius="12dp"
            app:strokeColor="@color/corner_card_border"
            app:strokeWidth="1dp" />


        <!-- ===================================================== -->
        <!-- START WORKOUT -->
        <!-- ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartWorkout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/training_start_workout"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/corner_red"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>