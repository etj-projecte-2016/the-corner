<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/corner_background" android:fillViewport="true">
    <LinearLayout android:id="@+id/formContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <ImageButton android:id="@+id/backButton" style="@style/TheCorner.Button.Icon" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/profile_back" android:src="@drawable/ic_arrow_back" android:tint="@color/corner_text_primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="@string/profile_edit_title" android:textColor="@color/corner_text_primary" android:textSize="28sp" android:textStyle="bold" />
        <View android:layout_width="40dp" android:layout_height="3dp" android:layout_marginTop="10dp" android:background="@color/corner_red" />
        <TextView style="@style/TheCorner.Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/profile_name" />
        <EditText android:id="@+id/nameInput" style="@style/ProfileInput" android:inputType="textCapWords" android:hint="@string/profile_name_hint" />
        <TextView style="@style/TheCorner.Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/profile_age" />
        <EditText android:id="@+id/ageInput" style="@style/ProfileInput" android:inputType="number" android:hint="@string/profile_age_hint" />
        <TextView style="@style/TheCorner.Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/profile_weight" />
        <EditText android:id="@+id/weightInput" style="@style/ProfileInput" android:inputType="numberDecimal" android:hint="@string/profile_weight_hint" />
        <TextView style="@style/TheCorner.Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/profile_height" />
        <EditText android:id="@+id/heightInput" style="@style/ProfileInput" android:inputType="number" android:hint="@string/profile_height_hint" />
        <Button android:id="@+id/saveButton" style="@style/TheCorner.Button.Primary" android:layout_width="match_parent" android:layout_marginTop="24dp" android:text="@string/profile_save" />
    </LinearLayout>
</ScrollView>
