<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/corner_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:id="@+id/aiToolbar"
        android:background="@color/corner_background">
        <ImageButton
            android:id="@+id/backButton"
            style="@style/TheCorner.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/ai_back"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/corner_text_primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:text="@string/ai_coach_title"
            android:textColor="@color/corner_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="@dimen/space_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/sessionDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/sessionTypeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ai_type_chip"
                    android:fontFamily="sans-serif-condensed"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:textColor="@color/corner_text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/notConfiguredContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="96dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="@string/ai_unavailable_title"
                    android:textAlignment="center"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/ai_unavailable_body"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="@string/ai_powered_by_groq"
                    android:textColor="@color/ai_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/readyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.16"
                    android:text="@string/ai_your_last_session"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_ai_session_card"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/sessionArtwork"
                            android:layout_width="104dp"
                            android:layout_height="104dp"
                            android:contentDescription="@string/home_last_session_image"
                            android:scaleType="centerCrop" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/readyDateText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.05"
                                android:textColor="@color/corner_text_primary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/readyWorkoutTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-condensed"
                                android:textColor="@color/corner_text_primary"
                                android:textSize="28sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/readyTypeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:background="@drawable/bg_ai_type_chip"
                            android:fontFamily="sans-serif-condensed"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/readyRoundsValue" style="@style/AiReadyStatValue" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ai_stat_rounds" style="@style/AiReadyStatLabel" />
                        <TextView android:id="@+id/readyDurationValue" style="@style/AiReadyStatValue" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ai_stat_total" style="@style/AiReadyStatLabel" />
                        <TextView android:id="@+id/readyCaloriesValue" style="@style/AiReadyStatValue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_stat_calories" style="@style/AiReadyStatLabel" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_ai_coach_card"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ai_sparkle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="@string/ai_ready_for_analysis"
                        android:textColor="@color/ai_accent"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/ai_ready_body"
                        android:textColor="@color/corner_text_primary"
                        android:textSize="17sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/ai_ready_detail"
                        android:textColor="@color/corner_text_primary"
                        android:textSize="17sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkGeminiButton"
                        style="@style/TheCorner.Button.Material.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="22dp"
                        android:text="@string/ai_analyze_session"
                        app:backgroundTint="@color/ai_focus"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/howItWorksCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_ai_coach_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_ai_info_icon"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_ai_bars"
                        android:tint="@color/corner_text_primary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_how_works_card_title"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/ai_how_works_card_body"
                            android:textColor="@color/corner_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_history_chevron"
                        android:tint="@color/corner_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/noWorkoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="96dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ai_sparkle" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="@string/ai_no_session_title"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/ai_no_session_body"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/successContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/analysisHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.035"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="34sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal">
                    <include layout="@layout/item_ai_stat_rounds" />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:background="@color/corner_divider" />
                    <include layout="@layout/item_ai_stat_total" />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:background="@color/corner_divider" />
                    <include layout="@layout/item_ai_stat_calories" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_ai_coach_card"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ai_sparkle" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.14"
                            android:text="@string/ai_coach_take"
                            android:textColor="@color/ai_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/coachTakeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="52dp"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/corner_text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.16"
                    android:text="@string/ai_what_went_well"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/positivesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.16"
                    android:text="@string/ai_what_to_improve"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/improvementsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_ai_focus_card"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_ai_focus_icon"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_target"
                        android:tint="@color/white" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.14"
                            android:text="@string/ai_next_session_focus"
                            android:textColor="@color/ai_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/nextFocusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
