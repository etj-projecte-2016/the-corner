<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/corner_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_title" android:textColor="@color/corner_text_primary" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ai_subtitle" android:textColor="@color/corner_text_secondary" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/ai_status_label" android:textColor="@color/corner_text_secondary" android:textSize="12sp" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ai_status_ready" android:textColor="@color/corner_text_primary" android:textSize="16sp" />
        <Button android:id="@+id/checkGeminiButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="@string/ai_check_button" android:textColor="@color/white" android:backgroundTint="@color/corner_red" />
        <TextView android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/bg_profile_panel" android:padding="16dp" android:textColor="@color/corner_text_primary" android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
