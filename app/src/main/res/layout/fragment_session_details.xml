<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/corner_background" android:paddingTop="@dimen/space_4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingHorizontal="@dimen/space_4">
        <ImageButton android:id="@+id/back" style="@style/TheCorner.Button.Icon" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/history_back" app:tint="@color/corner_text_primary" />
        <TextView style="@style/HistoryTitle" android:layout_width="0dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/history_details_title" />
        <Space android:layout_width="48dp" android:layout_height="1dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:id="@+id/content"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"
            android:clipToPadding="false" android:padding="@dimen/space_4">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:clipToOutline="true"
                    app:cardBackgroundColor="@color/surface" app:cardCornerRadius="@dimen/radius_large"
                    app:strokeColor="@color/corner_outline" app:strokeWidth="1dp" app:cardElevation="2dp">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="240dp">
                        <ImageView android:id="@+id/artwork" android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop" android:importantForAccessibility="no" />
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_session_artwork_scrim" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/workoutType" style="@style/HistoryTitle"
                            android:layout_gravity="bottom" android:textSize="28sp" android:padding="20dp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" app:cardBackgroundColor="@color/corner_surface"
                    app:cardCornerRadius="@dimen/radius_large" app:strokeColor="@color/border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="@dimen/space_4" android:showDividers="middle"
                        android:divider="@drawable/history_divider">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_3">
                            <TextView style="@style/HistorySecondary" android:layout_width="0dp" android:layout_weight="1" android:text="@string/history_date_label" />
                            <TextView android:id="@+id/date" style="@style/HistorySecondary" android:textColor="@color/corner_text_primary" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_3">
                            <TextView style="@style/HistorySecondary" android:layout_width="0dp" android:layout_weight="1" android:text="@string/history_time_label" />
                            <TextView android:id="@+id/time" style="@style/HistorySecondary" android:textColor="@color/corner_text_primary" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_3">
                            <TextView style="@style/HistorySecondary" android:layout_width="0dp" android:layout_weight="1" android:text="@string/history_rounds_label" />
                            <TextView android:id="@+id/rounds" style="@style/HistorySecondary" android:textColor="@color/corner_text_primary" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_3">
                            <TextView style="@style/HistorySecondary" android:layout_width="0dp" android:layout_weight="1" android:text="@string/history_duration_label" />
                            <TextView android:id="@+id/duration" style="@style/HistorySecondary" android:textColor="@color/corner_text_primary" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_3">
                            <TextView style="@style/HistorySecondary" android:layout_width="0dp" android:layout_weight="1" android:text="@string/calories_est_label" />
                            <TextView android:id="@+id/calories" style="@style/HistorySecondary" android:textColor="@color/corner_text_primary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/caloriesNote" style="@style/HistorySecondary" android:layout_marginTop="16dp" />
                <TextView style="@style/HistorySecondary" android:layout_marginTop="16dp" android:text="@string/history_duration_note" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <ProgressBar android:id="@+id/loading" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="center" android:indeterminateTint="@color/corner_red" />
        <LinearLayout android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">
            <TextView android:id="@+id/messageTitle" style="@style/HistoryTitle" android:gravity="center" />
            <TextView android:id="@+id/messageBody" style="@style/HistorySecondary" android:layout_marginTop="8dp" android:gravity="center" />
            <com.google.android.material.button.MaterialButton android:id="@+id/retry" style="@style/TheCorner.Button.Material.Secondary" android:layout_width="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/history_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
