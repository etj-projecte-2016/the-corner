<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/corner_background"
    tools:context=".ui.training.session.WorkoutSessionFragment">


    <!-- ====================================================== -->
    <!-- ROUND / REST FULL SCREEN BACKGROUND -->
    <!-- ====================================================== -->

    <ImageView
        android:id="@+id/ivSessionBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.55"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/session_grunge_background"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />


    <!-- ====================================================== -->
    <!-- COUNTDOWN / FIGHT FULL SCREEN -->
    <!--
         IMPORTANTE:
         Está FUERA de sessionContent.
         Por tanto no recibe ningún padding.
    -->
    <!-- ====================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/countdownContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">


        <!-- ================================================== -->
        <!-- BOXER: 3 / 2 / 1 -->
        <!-- ================================================== -->

        <ImageView
            android:id="@+id/ivCountdownBoxer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.22"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/countdown_boxer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================== -->
        <!-- BAG: FIGHT -->
        <!-- ================================================== -->

        <ImageView
            android:id="@+id/ivFightBag"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.18"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bag"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================== -->
        <!-- GET READY -->
        <!-- ================================================== -->

        <TextView
            android:id="@+id/tvCountdownReady"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:text="@string/session_get_ready"
            android:textColor="@color/corner_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvCountdownMain"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================== -->
        <!-- 3 / 2 / 1 / FIGHT -->
        <!-- ================================================== -->

        <TextView
            android:id="@+id/tvCountdownMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/corner_text_primary"
            android:textSize="250sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="3" />


        <!-- ================================================== -->
        <!-- COUNTDOWN STEPS -->
        <!-- ================================================== -->

        <LinearLayout
            android:id="@+id/countdownStepsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvCountdownMain"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <TextView
                android:id="@+id/tvCountdownStep3"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_countdown_step"
                android:gravity="center"
                tools:text="3"
                android:textColor="@color/corner_text_secondary"
                android:textSize="22sp"
                android:textStyle="bold" />


            <View
                android:layout_width="44dp"
                android:layout_height="2dp"
                android:background="@color/corner_outline" />


            <TextView
                android:id="@+id/tvCountdownStep2"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_countdown_step"
                android:gravity="center"
                tools:text="2"
                android:textColor="@color/corner_text_secondary"
                android:textSize="22sp"
                android:textStyle="bold" />


            <View
                android:layout_width="44dp"
                android:layout_height="2dp"
                android:background="@color/corner_outline" />


            <TextView
                android:id="@+id/tvCountdownStep1"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_countdown_step"
                android:gravity="center"
                tools:text="1"
                android:textColor="@color/corner_text_secondary"
                android:textSize="22sp"
                android:textStyle="bold" />


        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ====================================================== -->
    <!-- NORMAL SESSION CONTENT -->
    <!--
         Solo la UI normal tiene padding.
    -->
    <!-- ====================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sessionContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_5"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================== -->
        <!-- ROUND HEADER -->
        <!-- ================================================== -->

        <LinearLayout
            android:id="@+id/roundHeaderContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">


            <TextView
                android:id="@+id/tvRoundLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.04"
                android:text="@string/session_round"
                android:textColor="@color/corner_text_primary"
                android:textSize="23sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/tvCurrentRound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    tools:text="1"
                    android:textColor="@color/corner_red"
                    android:textSize="29sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvTotalRounds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="sans-serif-condensed"
                    tools:text="/ 10"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="27sp"
                    android:textStyle="bold" />


            </LinearLayout>


        </LinearLayout>


        <!-- ================================================== -->
        <!-- CENTRAL SESSION AREA -->
        <!-- ================================================== -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/centerTimerArea"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/roundHeaderContainer"
            app:layout_constraintBottom_toTopOf="@id/btnPauseWorkout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- TIMER -->

            <TextView
                android:id="@+id/tvSessionTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/corner_text_primary"
                android:textSize="150sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvSessionPhase"
                app:layout_constraintVertical_bias="0.42"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="2:47" />


            <!-- ROUND / REST -->

            <TextView
                android:id="@+id/tvSessionPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:text="@string/session_round"
                android:textColor="@color/corner_red"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvSessionTimer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- TIMELINE -->

            <LinearLayout
                android:id="@+id/roundTimelineContainer"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvSessionPhase"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- NEXT -->

            <TextView
                android:id="@+id/tvNextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:text="@string/session_next"
                android:textColor="@color/corner_text_secondary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/roundTimelineContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <LinearLayout
                android:id="@+id/nextPhaseContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvNextLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">


                <TextView
                    android:id="@+id/tvNextPhaseName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/session_rest"
                    android:textColor="@color/corner_rest"
                    android:textSize="24sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvNextPhaseDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-condensed"
                    tools:text="· 1:00"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />


            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ================================================== -->
        <!-- PAUSED -->
        <!-- ================================================== -->

        <TextView
            android:id="@+id/tvPaused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:text="@string/session_paused"
            android:textColor="@color/corner_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btnPauseWorkout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================== -->
        <!-- PAUSE -->
        <!-- ================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPauseWorkout"
            style="@style/TheCorner.Button.Material.Primary"
            android:layout_width="0dp"
            android:layout_marginBottom="10dp"
            android:text="@string/session_pause"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_pause"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="24dp"
            app:iconTint="@android:color/white"
            app:layout_constraintBottom_toTopOf="@id/btnEndWorkout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================== -->
        <!-- END -->
        <!-- ================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndWorkout"
            style="@style/TheCorner.Button.Material.Secondary"
            android:layout_width="0dp"
            android:text="@string/session_end_workout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================== -->
        <!-- COMPLETED WORKOUT SUMMARY -->
        <!-- ================================================== -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/completedSummaryContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivCompletedHero"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.72"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/boxer_bg_end_workout"
                android:translationY="-48dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_last_session_image_fade"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/completedHeroContentAnchor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.42" />

            <LinearLayout
                android:id="@+id/completedHeroCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_marginBottom="@dimen/space_6"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/completedHeroContentAnchor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvCompletedHeroTitlePrimary"
                    style="@style/TheCorner.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/session_workout"
                    android:textColor="@color/corner_text_primary" />

                <TextView
                    android:id="@+id/tvCompletedHeroTitleAccent"
                    style="@style/TheCorner.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/session_complete_short"
                    android:textColor="@color/corner_red" />

                <LinearLayout
                    android:id="@+id/completedHeroWorkoutTypeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="20dp"
                        android:layout_height="2dp"
                        android:layout_marginEnd="@dimen/space_2"
                        android:background="@color/corner_red" />

                    <TextView
                        android:id="@+id/tvCompletedHeroWorkoutType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.12"
                        android:textColor="@color/corner_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="20dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:background="@color/corner_red" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/completedSummaryScroll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:layout_marginTop="-56dp"
                app:layout_constraintTop_toTopOf="@id/completedHeroContentAnchor"
                app:layout_constraintBottom_toTopOf="@id/btnCompletedDone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_3"
                    android:paddingBottom="@dimen/space_4">

                    <TextView
                        android:id="@+id/tvCompletedTitlePrimary"
                        style="@style/TheCorner.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/session_workout"
                        android:textColor="@color/corner_text_primary" />

                    <TextView
                        android:id="@+id/tvCompletedTitleAccent"
                        style="@style/TheCorner.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/session_complete_short"
                        android:textColor="@color/corner_red" />

                    <LinearLayout
                        android:id="@+id/completedWorkoutTypeRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:layout_marginEnd="@dimen/space_2"
                            android:background="@color/corner_red" />

                        <TextView
                            android:id="@+id/tvCompletedWorkoutType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.12"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="BAG WORK" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:background="@color/corner_red" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/completedMetricsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_5"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/TheCorner.Card.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="96dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_2"
                                android:paddingTop="@dimen/space_2"
                                android:paddingEnd="@dimen/space_2"
                                android:paddingBottom="@dimen/space_2">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_timer"
                                        app:tint="@color/corner_red" />

                                    <TextView
                                        android:id="@+id/tvCompletedDurationValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_1"
                                        android:fontFamily="sans-serif-condensed"
                                        android:textColor="@color/corner_text_primary"
                                        android:textSize="25sp"
                                        android:textStyle="bold"
                                        tools:text="32:00" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_1"
                                        android:fontFamily="monospace"
                                        android:letterSpacing="0.05"
                                        android:text="@string/session_duration"
                                        android:textColor="@color/corner_text_secondary"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="52dp"
                                    android:background="@color/corner_outline" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_target"
                                        app:tint="@color/corner_red" />

                                    <TextView
                                        android:id="@+id/tvCompletedRoundsValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_1"
                                        android:fontFamily="sans-serif-condensed"
                                        android:textColor="@color/corner_text_primary"
                                        android:textSize="25sp"
                                        android:textStyle="bold"
                                        tools:text="6" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_1"
                                        android:fontFamily="monospace"
                                        android:letterSpacing="0.05"
                                        android:text="@string/session_rounds_label"
                                        android:textColor="@color/corner_text_secondary"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="52dp"
                                    android:background="@color/corner_outline" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_fire"
                                        app:tint="@color/corner_red" />

                                    <TextView
                                        android:id="@+id/tvCompletedCaloriesValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_1"
                                        android:fontFamily="sans-serif-condensed"
                                        android:textColor="@color/corner_text_primary"
                                        android:textSize="25sp"
                                        android:textStyle="bold"
                                        tools:text="420" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_1"
                                        android:fontFamily="monospace"
                                        android:letterSpacing="0.05"
                                        android:text="@string/session_calories_label"
                                        android:textColor="@color/corner_text_secondary"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/completedRoundsPanel"
                        style="@style/TheCorner.Card.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCompletedBreakdownTitle"
                            style="@style/TheCorner.Text.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/session_rounds_breakdown" />

                        <TextView
                            android:id="@+id/tvCompletedBreakdownDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/corner_text_secondary"
                            android:textSize="12sp"
                            tools:text="32:00" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_2"
                        android:background="@color/corner_divider" />

                    <HorizontalScrollView
                        android:id="@+id/completedRoundsGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:fillViewport="false"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/completedRoundBreakdownContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </ScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompletedDone"
                style="@style/TheCorner.Button.Material.Primary"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_4"
                android:text="@string/session_done"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
