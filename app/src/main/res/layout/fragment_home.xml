<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/corner_background"
    android:fillViewport="true"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="100dp"
        android:clipChildren="false"
        android:clipToPadding="false">


        <!-- ===================================================== -->
        <!-- HERO + FIRST ROW -->
        <!-- ===================================================== -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:clipChildren="false"
            android:clipToPadding="false">


            <!-- ================================================= -->
            <!-- BOXER - BACKGROUND -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_gravity="top"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:translationY="48dp">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/ivHomeHero"
                    android:layout_width="0dp"
                    android:layout_height="260dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:alpha="0.62"
                    android:contentDescription="@string/home_boxing_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/boxer" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CONTENT ABOVE THE BOXER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


                <!-- THE CORNER -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_app_title_the"
                        android:textColor="@color/corner_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_app_title_corner"
                        android:textColor="@color/corner_red"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- GREETING -->

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/home_greeting_evening"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_user_name"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMotivation"
                    android:layout_width="185dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/home_motivation"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="13sp" />


                <!-- THIS WEEK -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.08"
                    android:text="@string/home_this_week"
                    android:textColor="@color/corner_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <!-- ================================================= -->
                <!-- FIRST ROW -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:orientation="horizontal">


                    <!-- SESSIONS -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:elevation="4dp"
                        app:cardBackgroundColor="@color/corner_surface"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/corner_outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:src="@drawable/ic_boxing_glove"
                                app:tint="@color/corner_red" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSessionsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/corner_text_primary"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    tools:text="4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_sessions"
                                    android:textColor="@color/corner_text_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_this_week"
                                    android:textColor="@color/corner_text_secondary"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- DURATION -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:elevation="4dp"
                        app:cardBackgroundColor="@color/corner_surface"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/corner_outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:src="@drawable/ic_timer"
                                app:tint="@color/corner_red" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDurationValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/corner_text_primary"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    tools:text="57" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_minutes"
                                    android:textColor="@color/corner_text_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_average_duration"
                                    android:textColor="@color/corner_text_secondary"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>


        <!-- ===================================================== -->
        <!-- SECOND STATS ROW -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:orientation="horizontal">


            <!-- CALORIES -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/corner_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/corner_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_fire"
                        app:tint="@color/corner_red" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCaloriesValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            tools:text="634" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_calories"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_average_calories"
                            android:textColor="@color/corner_text_secondary"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- BAG ROUNDS -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/corner_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/corner_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_target"
                        app:tint="@color/corner_red" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvBagRoundsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            tools:text="7" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_rounds"
                            android:textColor="@color/corner_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_bag_average"
                            android:textColor="@color/corner_text_secondary"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- LAST SESSION -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvLastSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.04"
            android:text="@string/home_last_session"
            android:textColor="@color/corner_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="@color/corner_red" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLastSession"
            android:layout_width="match_parent"
            android:layout_height="165dp"
            app:cardBackgroundColor="@color/corner_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/corner_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


                <!-- TOP -->

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="103dp">

                    <ImageView
                        android:id="@+id/ivLastSession"
                        android:layout_width="235dp"
                        android:layout_height="130dp"
                        android:layout_gravity="end|bottom"
                        android:translationX="28dp"
                        android:translationY="4dp"
                        android:alpha="0.78"
                        android:contentDescription="@string/home_last_session_image"
                        android:scaleType="fitCenter"
                        android:src="@drawable/guantes" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="18dp">

                        <TextView
                            android:id="@+id/tvLastSessionType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.03"
                            android:text="@string/home_boxing"
                            android:textColor="@color/corner_red"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLastSessionDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/corner_text_secondary"
                            android:textSize="11sp"
                            tools:text="Yesterday · 19:42" />

                    </LinearLayout>

                </FrameLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/corner_outline" />


                <!-- STATS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="61dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <!-- DURATION -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="7dp"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/corner_red" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLastSessionDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/corner_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="58" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_minutes"
                                android:textColor="@color/corner_text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                    <View
                        android:layout_width="1dp"
                        android:layout_height="30dp"
                        android:background="@color/corner_outline" />


                    <!-- CALORIES -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="7dp"
                            android:src="@drawable/ic_fire"
                            app:tint="@color/corner_red" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLastSessionCalories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/corner_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="640" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_calories"
                                android:textColor="@color/corner_text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                    <View
                        android:layout_width="1dp"
                        android:layout_height="30dp"
                        android:background="@color/corner_outline" />


                    <!-- ROUNDS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="7dp"
                            android:src="@drawable/ic_target"
                            app:tint="@color/corner_red" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLastSessionRounds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/corner_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="10" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_rounds"
                                android:textColor="@color/corner_text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- WEEKLY ACTIVITY -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvWeeklyActivityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.04"
            android:text="@string/home_weekly_activity"
            android:textColor="@color/corner_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:background="@color/corner_red" />


        <!-- DAYS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_monday_short"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/dayMonday"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_day_inactive" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_tuesday_short"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/dayTuesday"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_day_inactive" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_wednesday_short"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/dayWednesday"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_day_inactive" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_thursday_short"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/dayThursday"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_day_inactive" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_friday_short"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/dayFriday"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_day_inactive" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_saturday_short"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/daySaturday"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_day_inactive" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/day_sunday_short"
                    android:textColor="@color/corner_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/daySunday"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_day_inactive" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>